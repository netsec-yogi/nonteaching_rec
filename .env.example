# ABV-IIITM Non-Teaching Recruitment Portal — environment template.
# Copy to .env and fill in. Never commit .env or real credentials.

APP_NAME="ABV-IIITM Non-Teaching Recruitment"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Kolkata
APP_URL=https://recruitment.iiitm.ac.in
# Base URL used in emailed links (referee invitations, password reset). Defaults to APP_URL.
FRONTEND_URL="${APP_URL}"
# Generate https:// URLs when TLS terminates at a proxy/load balancer.
FORCE_HTTPS=true
# Comma-separated proxy IPs/CIDRs whose X-Forwarded-* headers are trusted.
TRUSTED_PROXIES=127.0.0.1

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# MySQL 8.x (8.0 or 8.4 LTS)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ntrec
DB_USERNAME=ntrec
DB_PASSWORD=

# Sessions: SPA cookie authentication through Laravel Sanctum.
SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
# Host[:port] values from which the SPA is served (no scheme).
SANCTUM_STATEFUL_DOMAINS=recruitment.iiitm.ac.in

# Queue: referee invitations and all emails are queued. Use redis where available.
QUEUE_CONNECTION=redis
CACHE_STORE=redis
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

# Institutional SMTP server.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.iiitm.ac.in
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="recruitment@iiitm.ac.in"
MAIL_FROM_NAME="ABV-IIITM Gwalior Recruitment"

FILESYSTEM_DISK=local
# Applicant documents and generated PDFs. Must be a private (never web-served) disk.
RECRUITMENT_DOCUMENTS_DISK=private

# Optional ClamAV daemon for upload scanning (leave CLAMAV_HOST empty to disable).
CLAMAV_HOST=
CLAMAV_PORT=3310
# true: refuse uploads when ClamAV is configured but unreachable.
CLAMAV_FAIL_CLOSED=true

# Database backups (php artisan db:backup).
BACKUP_PATH=/var/backups/ntrec
BACKUP_KEEP_DAYS=30
# Extra mysqldump flags if needed, e.g. --ssl-mode=REQUIRED
BACKUP_DUMP_OPTIONS=

BROADCAST_CONNECTION=log
VITE_APP_NAME="${APP_NAME}"

# --- Docker production stack (compose.prod.yaml) -------------------------------
# With Docker, use DB_HOST=mysql, REDIS_HOST=redis, QUEUE_CONNECTION=redis, CACHE_STORE=redis,
# BACKUP_PATH=/var/backups/ntrec. Compose reads the values below from this same file.
DB_ROOT_PASSWORD=
# https: Nginx terminates TLS with certificates in TLS_CERT_DIR (fullchain.pem, privkey.pem).
# http:  an institute reverse proxy terminates TLS in front of this host.
NGINX_SITE=https
HTTP_PORT=80
HTTPS_PORT=443
TLS_CERT_DIR=./docker/prod/certs
IMAGE_TAG=latest

# ABV-IIITM Non-Teaching Recruitment Portal — environment template.
# Copy to .env and fill in. Never commit .env or real credentials.

APP_NAME="ABV-IIITM Non-Teaching Recruitment"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Kolkata
APP_URL=https://recruitment.iiitm.ac.in
# Base URL used in emailed links (referee invitations, password reset). Defaults to APP_URL.
FRONTEND_URL="${APP_URL}"
# Generate https:// URLs when TLS terminates at a proxy/load balancer.
FORCE_HTTPS=true
# Comma-separated proxy IPs/CIDRs whose X-Forwarded-* headers are trusted.
TRUSTED_PROXIES=127.0.0.1

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# MySQL 8.x (8.0 or 8.4 LTS)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ntrec
DB_USERNAME=ntrec
DB_PASSWORD=

# Sessions: SPA cookie authentication through Laravel Sanctum.
SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
# Host[:port] values from which the SPA is served (no scheme).
SANCTUM_STATEFUL_DOMAINS=recruitment.iiitm.ac.in

# Queue: referee invitations and all emails are queued. Use redis where available.
QUEUE_CONNECTION=redis
CACHE_STORE=redis
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

# Institutional SMTP server.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.iiitm.ac.in
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="recruitment@iiitm.ac.in"
MAIL_FROM_NAME="ABV-IIITM Gwalior Recruitment"
# Optional for the primary account: tls = require STARTTLS, ssl = implicit TLS (port 465).
MAIL_ENCRYPTION=
# Optional sending limits for the primary account (blank = none).
MAIL_PER_MINUTE=
MAIL_DAILY_LIMIT=

# Outgoing account pool. Off: every email uses the account above, exactly as before.
# On: the accounts listed in MAIL_POOL_ACCOUNTS join it. Each is configured by MAIL_<NAME>_*
# variables, so a third account needs only MAIL_POOL_ACCOUNTS=secondary,third and MAIL_THIRD_*.
# Strategy: round_robin (default), failover (primary first) or single (primary only).
MAIL_POOL_ENABLED=false
MAIL_POOL_STRATEGY=round_robin
MAIL_POOL_ACCOUNTS=secondary

# Each account must be a mailbox of its own, allowed to send as its From address (same domain
# as its login). Supply the password through the deployment environment, never the repository.
MAIL_SECONDARY_ENABLED=false
MAIL_SECONDARY_LABEL=Secondary
MAIL_SECONDARY_HOST=
MAIL_SECONDARY_PORT=587
MAIL_SECONDARY_USERNAME=
MAIL_SECONDARY_PASSWORD=
# tls (STARTTLS, port 587) or ssl (port 465). "none" is refused in production except on localhost.
MAIL_SECONDARY_ENCRYPTION=tls
MAIL_SECONDARY_FROM_ADDRESS=
MAIL_SECONDARY_FROM_NAME="ABV-IIITM Gwalior Recruitment"
MAIL_SECONDARY_TIMEOUT=15
MAIL_SECONDARY_PER_MINUTE=
MAIL_SECONDARY_DAILY_LIMIT=

# Failure handling (seconds; doubled for each consecutive failure of an account, up to the max).
MAIL_POOL_COOLDOWN_CONNECTION=60
MAIL_POOL_COOLDOWN_RATE_LIMITED=300
MAIL_POOL_COOLDOWN_QUOTA=3600
MAIL_POOL_COOLDOWN_AUTH=1800
MAIL_POOL_COOLDOWN_MAX=21600
MAIL_POOL_MAX_ATTEMPTS=5
MAIL_POOL_RETRY_FOR_HOURS=48
MAIL_POOL_WARN_AT_PERCENT=80

FILESYSTEM_DISK=local
# Applicant documents and generated PDFs. Must be a private (never web-served) disk.
RECRUITMENT_DOCUMENTS_DISK=private

# Optional ClamAV daemon for upload scanning (leave CLAMAV_HOST empty to disable).
CLAMAV_HOST=
CLAMAV_PORT=3310
# true: refuse uploads when ClamAV is configured but unreachable.
CLAMAV_FAIL_CLOSED=true

# Database backups (php artisan db:backup).
BACKUP_PATH=/var/backups/ntrec
BACKUP_KEEP_DAYS=30
# Extra mysqldump flags if needed, e.g. --ssl-mode=REQUIRED
BACKUP_DUMP_OPTIONS=

BROADCAST_CONNECTION=log
VITE_APP_NAME="${APP_NAME}"

# --- Docker production stack (compose.prod.yaml) -------------------------------
# With Docker, use DB_HOST=mysql, REDIS_HOST=redis, QUEUE_CONNECTION=redis, CACHE_STORE=redis,
# BACKUP_PATH=/var/backups/ntrec. Compose reads the values below from this same file.
DB_ROOT_PASSWORD=
# https: Nginx terminates TLS with certificates in TLS_CERT_DIR (fullchain.pem, privkey.pem).
# http:  an institute reverse proxy terminates TLS in front of this host.
NGINX_SITE=https
HTTP_PORT=80
HTTPS_PORT=443
TLS_CERT_DIR=./docker/prod/certs
IMAGE_TAG=latest
